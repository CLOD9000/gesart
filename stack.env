# Stack Gesart - configurazione docker compose.
#
# Copiare le credenziali qui e NON nel repository pubblico:
#   cp stack.env.example stack.env
#
# Avvio:  docker compose up -d --build
# Log:    docker compose logs -f gesart
# Stop:   docker compose down

# --- Porta esposta sull'host (l'app ascolta sempre su 9080 dentro il container)
GESART_PORT=9080

# --- Credenziali iniziali (usate solo al primo avvio, quando il DB e' vuoto)
GESART_ADMIN_USER=admin
GESART_ADMIN_PASSWORD=admin
GESART_ADMIN_NAME=Amministratore
GESART_OPERATOR_USER=operatore
GESART_OPERATOR_PASSWORD=operatore
GESART_SEED_OPERATOR=true

# --- Sessioni
GESART_SESSION_TTL_HOURS=12
# true se esposto via HTTPS ( dietro reverse proxy )
GESART_SECURE_COOKIES=false

# --- Import
GESART_MAX_UPLOAD_MB=64
GESART_STAGING_TTL_HOURS=24
# Azienda di default per gli articoli importati senza codice azienda
GESART_DEFAULT_AZIENDA=
